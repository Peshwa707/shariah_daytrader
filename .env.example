# Shariah Daytrading Bot - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# Application Settings
# ============================================================
ENVIRONMENT=paper  # development, paper, or live
DEBUG=false
LOG_LEVEL=INFO

# ============================================================
# Interactive Brokers Configuration
# ============================================================
IBKR_MODE=paper  # paper or live
IBKR_HOST=127.0.0.1
IBKR_CLIENT_ID=1
IBKR_USE_GATEWAY=false  # true to use IB Gateway instead of TWS

# Port configuration (uncomment to override defaults)
# IBKR_TWS_PAPER_PORT=7497
# IBKR_TWS_LIVE_PORT=7496
# IBKR_GATEWAY_PAPER_PORT=4002
# IBKR_GATEWAY_LIVE_PORT=4001

# Market data type: 1=Live, 2=Frozen, 3=Delayed, 4=Delayed Frozen
IBKR_MARKET_DATA_TYPE=3

# ============================================================
# API Keys (Optional - for enhanced data)
# ============================================================

# Alpha Vantage - Free tier: 25 requests/day
# Get your key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Zoya API - Optional Shariah verification
# Get your key at: https://zoya.finance/api
ZOYA_API_KEY=

# ============================================================
# Shariah Configuration (Optional - defaults are AAOIFI)
# ============================================================
# SHARIAH_MAX_DEBT_TO_MARKET_CAP=0.30
# SHARIAH_MAX_DEPOSITS_TO_MARKET_CAP=0.30
# SHARIAH_MAX_IMPERMISSIBLE_INCOME_RATIO=0.05
# SHARIAH_MAX_RECEIVABLES_TO_MARKET_CAP=0.49
# SHARIAH_MAX_PROHIBITED_REVENUE_RATIO=0.05
